{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "enum": [
        "devto",
        "hashnode",
        "gist",
        "github-discussion",
        "linkedin",
        "x",
        "bluesky",
        "mastodon",
        "threads",
        "reddit",
        "hn",
        "producthunt",
        "lemmy",
        "newsletter",
        "medium",
        "substack",
        "youtube-shorts",
        "instagram",
        "tiktok",
        "dailydev"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "marketBlaster": {
      "type": [
        "string",
        "null"
      ]
    },
    "ai": {
      "enum": [
        "draft",
        "outline",
        "none"
      ]
    },
    "aiSource": { "type": "string", "minLength": 1 },
    "aiLastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "text",
          "thread",
          "article",
          "image",
          "carousel",
          "diagram",
          "poster",
          "logo",
          "video",
          "terminal-demo"
        ]
      }
    },
    "textLimit": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "verified": {
              "type": "string"
            },
            "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          "required": [
            "value",
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "titleLimit": {
      "anyOf": [
        {
          "const": "unknown"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "verified": {
              "type": "string"
            },
            "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          "required": [
            "value",
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "image",
              "video",
              "document",
              "gif"
            ]
          },
          "aspectRatios": {
            "anyOf": [
              {
                "const": "unknown"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verified": {
                    "type": "string"
                  },
                  "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxBytes": {
            "anyOf": [
              {
                "const": "unknown"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verified": {
                    "type": "string"
                  },
                  "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxSeconds": {
            "anyOf": [
              {
                "const": "unknown"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verified": {
                    "type": "string"
                  },
                  "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minSeconds": {
            "anyOf": [
              {
                "const": "unknown"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verified": {
                    "type": "string"
                  },
                  "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxCount": {
            "anyOf": [
              {
                "const": "unknown"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verified": {
                    "type": "string"
                  },
                  "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          },
          "width": {
            "anyOf": [
              {
                "const": "unknown"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verified": {
                    "type": "string"
                  },
                  "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          },
          "height": {
            "anyOf": [
              {
                "const": "unknown"
              },
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verified": {
                    "type": "string"
                  },
                  "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                },
                "required": [
                  "value",
                  "source"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "safeZones": {
      "type": "object",
      "properties": {
        "video": { "$ref": "#/definitions/safeZone" },
        "image": { "$ref": "#/definitions/safeZone" }
      },
      "additionalProperties": false
    },
    "marketBlasterMedia": {
      "type": "object",
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "allowedKinds": { "type": "array", "uniqueItems": true, "items": { "enum": ["image", "video", "document", "gif"] } },
        "exclusiveKinds": { "type": "array", "items": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["image", "video", "document", "gif"] } } },
        "maxCount": { "type": "integer", "minimum": 0 }
      },
      "required": ["source", "allowedKinds"],
      "additionalProperties": false
    },
    "disclosure": {
      "type": "object",
      "properties": {
        "text": {
          "anyOf": [
            {
              "enum": [
                "recommended",
                "unknown"
              ]
            },
            {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "verified": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "accepts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "acceptsWhenGenerated": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              },
              "required": [
                "rule",
                "source"
              ],
              "additionalProperties": false
            }
          ]
        },
        "media": {
          "anyOf": [
            {
              "enum": [
                "recommended",
                "unknown"
              ]
            },
            {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "verified": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "accepts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              },
              "required": [
                "rule",
                "source"
              ],
              "additionalProperties": false
            }
          ]
        },
        "voice": {
          "anyOf": [
            {
              "enum": [
                "recommended",
                "unknown"
              ]
            },
            {
              "type": "object",
              "properties": {
                "rule": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "verified": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "accepts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              },
              "required": [
                "rule",
                "source"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "text",
        "media",
        "voice"
      ],
      "additionalProperties": false
    },
    "sponsorship": {
      "anyOf": [
        { "enum": ["recommended", "unknown"] },
        {
          "type": "object",
          "properties": {
            "rule": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 },
            "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "lastVerified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "accepts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          },
          "required": ["rule", "source"],
          "additionalProperties": false
        }
      ]
    },
    "rubric": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/definitions/criterion" }
    },
    "outlineRubric": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/definitions/criterion" }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minFontPx": { "type": "number", "minimum": 0 },
        "minContrast": { "type": "number", "minimum": 0 },
        "minContrastLarge": { "type": "number", "minimum": 0 },
        "largeTextPx": { "type": "number", "minimum": 0 }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "safeZone": {
      "oneOf": [
        { "const": "unknown" },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "object",
              "properties": {
                "top": { "type": "number", "minimum": 0, "maximum": 1 },
                "bottom": { "type": "number", "minimum": 0, "maximum": 1 },
                "left": { "type": "number", "minimum": 0, "maximum": 1 },
                "right": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": ["top", "bottom", "left", "right"],
              "additionalProperties": false
            },
            "source": { "type": "string", "minLength": 1 },
            "verified": { "type": "string" },
            "lastVerified": { "type": "string" }
          },
          "required": ["value", "source"],
          "additionalProperties": false
        }
      ]
    },
    "criterion": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "anchors": {
          "type": "object",
          "properties": {
            "0": { "type": "string", "minLength": 1 },
            "1": { "type": "string", "minLength": 1 },
            "2": { "type": "string", "minLength": 1 }
          },
          "required": ["0", "1", "2"],
          "additionalProperties": false
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["text", "thread", "article", "image", "carousel", "diagram", "poster", "logo", "video", "terminal-demo"] }
        }
      },
      "required": ["id", "question", "anchors"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "marketBlaster",
    "ai",
    "formats",
    "media",
    "disclosure",
    "rubric",
    "sources"
  ],
  "additionalProperties": false
}
