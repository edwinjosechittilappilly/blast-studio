{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blast-studio.local/schemas/campaign.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "slug", "title", "generatedAt", "generator", "canonicalHome", "sources", "destinations", "manual"],
  "properties": {
    "version": { "const": 2 },
    "kind": { "const": "blast-studio-campaign" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "blast-studio" }, "version": { "type": "string", "minLength": 1 } } },
    "canonicalHome": { "type": ["string", "null"], "minLength": 1 },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "destinations": { "type": "array", "items": { "$ref": "#/$defs/destination" } },
    "manual": { "type": "array", "items": { "$ref": "#/$defs/manual" } }
  },
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["anchor", "title", "status", "url"], "properties": { "anchor": { "type": "string", "pattern": "^E[0-9]+$" }, "title": { "type": "string" }, "status": { "enum": ["shipped", "planned", "claim", null] }, "url": { "type": ["string", "null"] } } },
    "media": { "type": "object", "additionalProperties": false, "required": ["path", "alt", "kind"], "properties": { "path": { "type": "string", "pattern": "^media/" }, "alt": { "type": "string" }, "kind": { "enum": ["image", "video", "gif", "document"] }, "cover": { "type": "boolean" }, "lang": { "type": "string" }, "captions": { "type": "string", "pattern": "^media/" } } },
    "review": { "type": "object", "additionalProperties": false, "required": ["verdict", "total", "reviewHash"], "properties": { "verdict": { "enum": ["pass", "accepted"] }, "total": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }, "reviewHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "destination": { "type": "object", "additionalProperties": false, "required": ["id", "mode", "aiPolicy", "post", "media", "thread", "review"], "properties": { "id": { "type": "string", "minLength": 1 }, "mode": { "enum": ["api", "handoff"] }, "aiPolicy": { "enum": ["draft", "outline", "none"] }, "post": { "type": ["string", "null"] }, "tags": { "type": "array", "items": { "type": "string" } }, "media": { "type": "array", "items": { "$ref": "#/$defs/media" } }, "thread": { "type": ["string", "null"] }, "review": { "$ref": "#/$defs/review" } } },
    "manual": { "type": "object", "additionalProperties": false, "required": ["platform", "folder", "review"], "properties": { "platform": { "enum": ["youtube-shorts", "instagram", "tiktok", "dailydev"] }, "folder": { "type": "string", "pattern": "^handoff/.+/$" }, "review": { "type": "object", "additionalProperties": false, "required": ["verdict", "total"], "properties": { "verdict": { "enum": ["pass", "accepted"] }, "total": { "type": ["number", "null"], "minimum": 0, "maximum": 100 } } } } }
  }
}
