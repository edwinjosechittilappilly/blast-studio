{
  "name": "blast-studio",
  "version": "0.1.1",
  "description": "Create, review and score platform-ready content (text, images, carousels, diagrams, posters, logos, short video) and hand it to Market Blaster.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Edwin Jose Chittilappilly",
  "repository": {
    "type": "git",
    "url": "https://github.com/edwinjosechittilappilly/blast-studio.git"
  },
  "homepage": "https://edwinjosechittilappilly.github.io/blast-studio/",
  "bugs": "https://github.com/edwinjosechittilappilly/blast-studio/issues",
  "keywords": ["content", "social-media", "cli", "publishing", "studio"],
  "files": ["bin", "dist", "templates", "platforms", "schemas", "skills", "providers/prices.yml", "test/fixtures/reviews"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "bstudio": "bin/bstudio.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build:ui": "esbuild src/dashboard/ui/app.js --bundle --format=esm --outfile=src/dashboard/build/app.js && esbuild src/dashboard/ui/app.css --bundle --outfile=src/dashboard/build/app.css",
    "dev:ui": "esbuild src/dashboard/ui/app.js src/dashboard/ui/app.css --bundle --format=esm --outdir=src/dashboard/build --watch",
    "build": "npm run build:ui && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/dashboard/static', 'dist/dashboard/static', { recursive: true }); require('node:fs').cpSync('src/dashboard/build', 'dist/dashboard/static', { recursive: true })\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@carbon/styles": "^1.93.0",
    "@carbon/web-components": "^2.50.0",
    "@resvg/resvg-js": "2.6.2",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "playwright": "1.65.1",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@mermaid-js/mermaid-cli": "12.2.0",
    "hyperframes": "0.9.80"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
