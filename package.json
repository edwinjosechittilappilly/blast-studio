    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@mermaid-js/mermaid-cli": "12.2.0",
    "hyperframes": "0.9.80"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
