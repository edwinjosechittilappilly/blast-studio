{
  "name": "blast-studio",
  "version": "0.1.2",
  "description": "Create, review and score platform-ready content (text, images, carousels, diagrams, posters, logos, short video) and hand it to Market Blaster.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Edwin Jose Chittilappilly",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwinjosechittilappilly/blast-studio.git"
  },
  "homepage": "https://edwinjosechittilappilly.github.io/blast-studio/",
  "bugs": "https://github.com/edwinjosechittilappilly/blast-studio/issues",
  "keywords": ["content", "social-media", "cli", "publishing", "studio"],
  "files": ["bin", "dist", "templates", "platforms", "schemas", "skills", "providers/prices.yml", "test/fixtures/reviews"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "bstudio": "bin/bstudio.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "pretest": "npm run build:ui",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\" \"test/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "build:ui": "node src/dashboard/ui/build.mjs",
    "dev:ui": "node src/dashboard/ui/build.mjs --watch",
    "build": "npm run build:ui && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs'); fs.cpSync('src/dashboard/static', 'dist/dashboard/static', { recursive: true }); fs.cpSync('src/dashboard/build', 'dist/dashboard/static', { recursive: true }); fs.copyFileSync('node_modules/@ibm/plex-sans/fonts/complete/woff2/license.txt', 'dist/dashboard/static/plex-license.txt')\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "ajv": "8.20.0",
    "fflate": "0.8.3",
    "playwright": "1.65.1",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@mermaid-js/mermaid-cli": "12.2.0",
    "hyperframes": "0.9.80"
  },
  "devDependencies": {
    "@carbon/icons": "^11.92.0",
    "@carbon/styles": "^1.93.0",
    "@carbon/web-components": "^2.50.0",
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans": "^1.1.0",
    "esbuild": "^0.25.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
